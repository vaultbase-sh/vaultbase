    {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "additionalProperties": false,
            "properties": {
              "active": {
                "description": "bool",
                "type": "boolean"
              },
              "address": {
                "additionalProperties": false,
                "description": "group (one object)",
                "properties": {
                  "city": {
                    "description": "text",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "author": {
                "description": "relation (id of a record in the 'people' collection)",
                "type": "string"
              },
              "body": {
                "description": "editor",
                "type": "string"
              },
              "contact": {
                "description": "email",
                "format": "email",
                "type": "string"
              },
              "cover": {
                "description": "file (filename — files must be uploaded via the file upload endpoint, not this tool)",
                "type": "string"
              },
              "docs": {
                "description": "file (filename — files must be uploaded via the file upload endpoint, not this tool)",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "emb": {
                "description": "vector (3-dim vector)",
                "items": {
                  "type": "number"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              "hue": {
                "description": "color (hex color, e.g. #e85a4f)",
                "type": "string"
              },
              "items": {
                "description": "group (min 1, max 5) (list of items; send the whole list, it replaces the stored one)",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "description": "keep an item's id when updating; omit it for a new item",
                      "pattern": "^[A-Za-z0-9_-]{1,64}$",
                      "type": "string"
                    },
                    "qty": {
                      "description": "number",
                      "type": "number"
                    },
                    "sku": {
                      "description": "text (required)",
                      "type": "string"
                    }
                  },
                  "required": [
                    "sku"
                  ],
                  "type": "object"
                },
                "maxItems": 5,
                "minItems": 1,
                "type": "array"
              },
              "labels": {
                "description": "select",
                "items": {
                  "description": "select",
                  "enum": [
                    "a",
                    "b"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              "meta": {
                "description": "json"
              },
              "price": {
                "description": "number",
                "type": "number"
              },
              "pt": {
                "description": "geoPoint",
                "properties": {
                  "lat": {
                    "maximum": 90,
                    "minimum": -90,
                    "type": "number"
                  },
                  "lng": {
                    "maximum": 180,
                    "minimum": -180,
                    "type": "number"
                  }
                },
                "required": [
                  "lat",
                  "lng"
                ],
                "type": "object"
              },
              "secret": {
                "description": "password",
                "type": "string"
              },
              "site": {
                "description": "url",
                "format": "uri",
                "type": "string"
              },
              "status": {
                "description": "select",
                "enum": [
                  "draft",
                  "published"
                ],
                "type": "string"
              },
              "title": {
                "description": "text (required)",
                "type": "string"
              },
              "when": {
                "description": "date (unix-seconds)",
                "type": "integer"
              }
            },
            "required": [
              "title"
            ],
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
