# Copy to .env next to where you run docker compose.
DOMAIN=vaultbase.example.com
# Generate each with: openssl rand -base64 32
# Keep them: a new JWT secret signs everyone out, a lost encryption key makes encrypted values unreadable.
VAULTBASE_JWT_SECRET=
VAULTBASE_ENCRYPTION_KEY=
# Pin a version, or leave latest.
VAULTBASE_VERSION=latest
VAULTBASE_READ_WORKERS=0
